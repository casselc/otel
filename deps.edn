{:paths ["src"]

 ;; OTLP export goes over casselc/http-client (clj-http-lite on jolt), which
 ;; brings TLS through the system OpenSSL — so an https collector endpoint works
 ;; without this library owning a socket or a TLS handshake. jolt-crypto is
 ;; http-client's own dependency; it is declared here too because it is what
 ;; supplies libssl/libcrypto, and naming it makes the OpenSSL requirement
 ;; visible rather than an implicit transitive fact.
 :deps {io.github.casselc/http-client {:git/url "https://github.com/casselc/http-client.git"
                                      :git/sha "eba91d0536fee73ee192f68676915e48be23b348"}
        jolt-lang/jolt-crypto {:git/url "https://github.com/jolt-lang/jolt-crypto"
                               :git/sha "8a3247f698fbd462cddae9b206a7e3b3aac1bb92"}
        org.clojure/tools.logging {:git/url "https://github.com/jolt-lang/logging"
                                   :git/sha "ec6747e55583118d881faf4ab41e68d7e587ce4c"}}

 :aliases {:test {:extra-paths ["test"]
                  :extra-deps
                  {io.github.chucklehead-dev/jolt-hegel
                   {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
                    :git/sha "53631c81cd927175935037699ddf687d98a44d24"}}}}

 ;; A map task applies the project's own :paths only, so the test task shells back
 ;; through jolt with -M:test to pick up the :test alias's extra path.
 :tasks {test "jolt -M:test -m otel.test-runner"}}
